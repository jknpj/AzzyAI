# Normalize line endings: LF inside the repository, native in the working tree.
# Without this, saving a file on Windows (CRLF) makes ~150 files look modified.
* text=auto

# Binary files: never convert, never diff as text
*.png binary
*.ico binary
*.gif binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.exe binary
*.dll binary
*.pdb binary
*.pfx binary
*.suo binary
*.doc binary
*.pdf binary
*.zip binary
*.deploy binary
